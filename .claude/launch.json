{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "coaching-api",
      "runtimeExecutable": "services/coaching-api/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "src.main:app", "--app-dir", "services/coaching-api", "--host", "0.0.0.0", "--port", "8811"],
      "port": 8811
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "apps/web", "run", "dev"],
      "port": 3000
    }
  ]
}
