    },
    "/api/v1/deliveries/{delivery_id}/nudge-ffs": {
      "post": {
        "tags": [
          "deliveries"
        ],
        "summary": "Nudge Ffs",
        "description": "[Nudge FFS Frame +/-1] coach control (PRD \u00a76.1).",
        "operationId": "nudge_ffs_api_v1_deliveries__delivery_id__nudge_ffs_post",
        "parameters": [
          {
            "name": "delivery_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Delivery Id"
            }
          },
          {
            "name": "frame_delta",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Frame Delta"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CoachingReport"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/deliveries/{delivery_id}/action": {
      "post": {
        "tags": [
          "coach-actions"
        ],
        "summary": "Record Coach Action",
        "description": "[Approve Drill] / [Dismiss] coach controls (PRD \u00a74 Layer 3). Records\nagainst the delivery's latest verdict - human-in-the-loop feedback is an\naudit-trail append, never a mutation of the verdict itself.",
        "operationId": "record_coach_action_api_v1_deliveries__delivery_id__action_post",
        "parameters": [
          {
            "name": "delivery_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Delivery Id"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CoachActionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "title": "Response Record Coach Action Api V1 Deliveries  Delivery Id  Action Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/athletes": {
      "get": {
        "tags": [
          "athletes"
        ],
        "summary": "List Athletes",
        "description": "The roster the capture app draws its session pool from. Returns every\nathlete \u2014 `athletes` has no per-coach ownership column yet (see\nrepository.list_athletes).",
        "operationId": "list_athletes_api_v1_athletes_get",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AthleteSummary"
                  },
                  "title": "Response List Athletes Api V1 Athletes Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "athletes"
        ],
        "summary": "Create Athlete",
        "description": "Player registration, consumed by the coach dashboard \u2014 not by the\ncapture app, which only ever reads the roster (MOBILE_PLAN.md \u00a72).\n`bowling_arm` is required here precisely so the capture app never has to\nguess which leg is the front leg.",
        "operationId": "create_athlete_api_v1_athletes_post",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AthleteCreateRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AthleteSummary"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/athletes/{athlete_id}/consent": {
      "patch": {
        "tags": [
          "athletes"
        ],
        "summary": "Update Athlete Consent",
        "description": "Updates guardian consent for an athlete.\n\nUnblocks youth athletes whose guardian has granted consent via WhatsApp,\nclub registration form, or verified parental confirmation.",
        "operationId": "update_athlete_consent_api_v1_athletes__athlete_id__consent_patch",
        "parameters": [
          {
            "name": "athlete_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Athlete Id"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AthleteConsentUpdateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AthleteSummary"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/athletes/{athlete_id}/sessions": {
      "post": {
        "tags": [
          "athletes"
        ],
        "summary": "Start Or Resume Session",
        "description": "Get-or-create today's session for this athlete (PRD nets workflow:\none coach/one phone, multiple bowlers taking turns - the mobile app\ncalls this on every \"which bowler is up\" switch, and gets back the same\nsession_id all day for a player it's already recorded).",
        "operationId": "start_or_resume_session_api_v1_athletes__athlete_id__sessions_post",
        "parameters": [
          {
            "name": "athlete_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Athlete Id"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/athletes/{athlete_id}/baseline": {
      "post": {
        "tags": [
          "athletes"
        ],
        "summary": "Confirm Baseline",
        "description": "Coach-confirmed Fixed Reference Baseline (PRD \u00a74 Layer 2: median + IQR\nacross 8-10 un-fatigued benchmark deliveries). This endpoint just stores\nthe confirmed numbers - computing them from a batch of deliveries is a\ncoach/UI workflow step, not something this endpoint does itself.",
        "operationId": "confirm_baseline_api_v1_athletes__athlete_id__baseline_post",
        "parameters": [
          {
            "name": "athlete_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Athlete Id"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BaselineConfirmRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "title": "Response Confirm Baseline Api V1 Athletes  Athlete Id  Baseline Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/athletes/{athlete_id}/history": {
      "get": {
        "tags": [
          "athletes"
        ],
        "summary": "Get Athlete History",
        "operationId": "get_athlete_history_api_v1_athletes__athlete_id__history_get",
        "parameters": [
          {
            "name": "athlete_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Athlete Id"
            }
