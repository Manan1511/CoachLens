        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  },
                  "title": "Response Get Athlete History Api V1 Athletes  Athlete Id  History Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AthleteConsentUpdateRequest": {
        "properties": {
          "guardian_consent": {
            "type": "boolean",
            "title": "Guardian Consent"
          }
        },
        "type": "object",
        "required": [
          "guardian_consent"
        ],
        "title": "AthleteConsentUpdateRequest"
      },
      "AthleteCreateRequest": {
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "title": "Name"
          },
          "bowling_arm": {
            "$ref": "#/components/schemas/BowlingArm"
          },
          "dob": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dob"
          },
          "guardian_consent": {
            "type": "boolean",
            "title": "Guardian Consent",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "name",
          "bowling_arm"
        ],
        "title": "AthleteCreateRequest"
      },
      "AthleteSummary": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "bowling_arm": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BowlingArm"
              },
              {
                "type": "null"
              }
            ]
          },
          "guardian_consent": {
            "type": "boolean",
            "title": "Guardian Consent"
          },
          "consent_blocked": {
            "type": "boolean",
            "title": "Consent Blocked"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "guardian_consent",
          "consent_blocked"
        ],
        "title": "AthleteSummary",
        "description": "A roster entry, as returned by GET /api/v1/athletes.\n\nDeliberately omits `dob`: the capture app reads this list on a phone\nshared net-side between players, and it needs to know whether an athlete\ncan be recorded, not their birthday."
      },
      "BaselineConfirmRequest": {
        "properties": {
          "metric": {
            "type": "string",
            "title": "Metric"
          },
          "median_deg": {
            "type": "number",
            "title": "Median Deg"
          },
          "iqr_deg": {
            "type": "number",
            "title": "Iqr Deg"
          }
        },
        "type": "object",
        "required": [
          "metric",
          "median_deg",
          "iqr_deg"
        ],
        "title": "BaselineConfirmRequest"
      },
      "Baselines": {
        "properties": {
          "fixed_reference_median_deg": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fixed Reference Median Deg"
          },
          "fixed_reference_iqr_deg": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fixed Reference Iqr Deg"
          },
          "rolling_6wk_median_deg": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rolling 6Wk Median Deg"
          },
          "delta_deg": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Delta Deg"
          },
          "uncertainty_band_deg": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Uncertainty Band Deg"
          }
        },
        "type": "object",
        "title": "Baselines"
      },
      "BowlingArm": {
        "type": "string",
        "enum": [
          "RIGHT",
          "LEFT"
        ],
        "title": "BowlingArm"
      },
      "CaptureMetadata": {
        "properties": {
          "fps": {
            "type": "integer",
            "title": "Fps"
          },
          "pacing_jitter_pct": {
            "type": "number",
            "title": "Pacing Jitter Pct"
          },
          "shutter_speed_sec": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Shutter Speed Sec"
          },
          "distance_meters": {
            "type": "number",
            "title": "Distance Meters"
          },
          "tripod_height_meters": {
            "type": "number",
            "title": "Tripod Height Meters"
          },
          "camera_roll_deg": {
            "type": "number",
            "title": "Camera Roll Deg"
          }
        },
        "type": "object",
        "required": [
          "fps",
          "pacing_jitter_pct",
          "distance_meters",
          "tripod_height_meters",
          "camera_roll_deg"
        ],
        "title": "CaptureMetadata"
      },
      "CoachActionRequest": {
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "APPROVE",
              "DISMISS"
            ],
            "title": "Action"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          }
        },
        "type": "object",
        "required": [
          "action"
        ],
        "title": "CoachActionRequest"
      },
      "CoachingReport": {
        "properties": {
          "report_id": {
            "type": "string",
            "title": "Report Id"
          },
          "delivery_id": {
            "type": "string",
            "title": "Delivery Id"
          },
          "evaluation_timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Evaluation Timestamp"
          },
          "kinematics": {
            "$ref": "#/components/schemas/Kinematics"
          },
          "baselines": {
            "$ref": "#/components/schemas/Baselines"
          },
          "verdict": {
            "$ref": "#/components/schemas/Verdict"
          },
          "proposed_action": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ProposedAction"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "report_id",
          "delivery_id",
          "evaluation_timestamp",
          "kinematics",
          "baselines",
          "verdict"
        ],
        "title": "CoachingReport"
      },
      "DeliveryIngestionRequest": {
        "properties": {
          "delivery_id": {
            "type": "string",
            "title": "Delivery Id"
          },
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "capture_metadata": {
            "$ref": "#/components/schemas/CaptureMetadata"
          },
          "raw_keypoints": {
            "items": {
              "$ref": "#/components/schemas/KeypointFrame"
            },
            "type": "array",
            "title": "Raw Keypoints"
          }
